{
  "name": "resume-matcher-fullstack",
  "version": "1.0.0",
  "description": "Resume Matcher - Full Stack Application with React frontend and Node.js backend",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.10.5",
